# OpenAI-compatible API endpoint and server-only credential
BASE_URL=https://api.openai.com/v1
API_KEY=replace-me

# Text, vision and image-generation models
LLM_MODEL=gpt-4.1-mini
VL_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1

# Optional Reddit OAuth. Without these, reddit-search uses public RSS.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=VibeNodeFlow/1.0 local-workflow-studio
# Set to 1 only when Reddit must bypass HTTP(S)/ALL_PROXY variables.
REDDIT_DISABLE_PROXY=0

# Optional canonical URL used by the local MP4 renderer.
STUDIO_URL=http://127.0.0.1:3000

# Edge TTS narration needs no key. Set a proxy only when the Microsoft
# endpoint is unreachable directly; SOCKS URLs are ignored (HTTP CONNECT only).
# Falls back to HTTPS_PROXY/HTTP_PROXY when unset.
EDGE_TTS_PROXY=
# Set to 1 to force a direct connection and ignore every proxy variable.
EDGE_TTS_DISABLE_PROXY=0

# Workflow safety limit (defaults to 10 when omitted)
MAX_FLOW_NODES=10
